<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Project.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Project"
    xmlns:views="clr-namespace:Project.view"
    Shell.FlyoutBehavior="Disabled">

    <!-- מסך הכניסה הוא המסך הראשוני והוא בודד (ללא סרגל תחתון) -->
    <ShellContent
        Title="SignIn"
        ContentTemplate="{DataTemplate views:SignUpPic}"
        Route="SignUpPic" />

    <!-- המסך הראשי רשום כנתיב נפרד -->
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    
    <!-- מסך הרשמה -->
    <ShellContent
        Title="SignUp"
        ContentTemplate="{DataTemplate views:SignUpPage}"
        Route="SignUpPage" />
</Shell>